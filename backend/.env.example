CACHE_DIR=app/data/cache
CACHE_MAX_AGE_HOURS=24
ALLOWED_ORIGINS=http://localhost:5173
# Alpha Vantage (ETFs): clave gratuita en https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=your_key_here
# Solo aplica a DCA diario en ETFs: compact (~100 sesiones, gratuito) o full (historial largo, requiere plan premium).
ALPHAVANTAGE_DAILY_OUTPUTSIZE=compact
